# Copie este arquivo para ".env" (nunca comite o ".env" de verdade — já está no .gitignore)
# e preencha com os valores reais antes de rodar "npm run dev".

# String de conexão do Neon Postgres (console Neon → Connection Details).
# Troque a senha no console ANTES de usar — a antiga foi exposta publicamente no histórico do git.
DATABASE_URL=postgresql://usuario:senha@host/neondb?sslmode=require

# Segredo usado para assinar o token de login. Gere um valor aleatório só seu, por exemplo:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=troque-por-um-valor-aleatorio-longo
